local function formatDots(n)
	n = math.floor(tonumber(n) or 0)
	local s = tostring(n)
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
	return out
end

local function formatHMS(sec)
	sec = math.max(0, math.floor(sec))
	local h = math.floor(sec / 3600)
	local m = math.floor((sec % 3600) / 60)
	local s = sec % 60
	return string.format("%02d:%02d:%02d", h, m, s)
end

local function statsLoad()
	-- local file first
	pcall(function()
		if readfile and isfile and isfile(STATS_FILE) then
			local decoded = HttpService:JSONDecode(readfile(STATS_FILE))
			if type(decoded) == "table" then
				for k, v in pairs(decoded) do
					if StatsData[k] ~= nil then StatsData[k] = v end
				end
			end
		end
	end)
	-- optional remote gist seed (read-only)
	pcall(function()
		local body = nil
		if request then
			local res = request({Url = PASTEBIN_URL, Method = "GET"})
			body = res and (res.Body or res.body)
		elseif syn and syn.request then
			local res = syn.request({Url = PASTEBIN_URL, Method = "GET"})
			body = res and res.Body
		end
		if body and #body > 2 then
			local decoded = HttpService:JSONDecode(body)
			if type(decoded) == "table" and type(decoded[tostring(player.UserId)]) == "table" then
				local remote = decoded[tostring(player.UserId)]
				if (remote.execCount or 0) > (StatsData.execCount or 0) then
					StatsData.execCount = remote.execCount
				end
				if (remote.totalMoneyGained or 0) > (StatsData.totalMoneyGained or 0) then
					StatsData.totalMoneyGained = remote.totalMoneyGained
				end
				if (remote.longestAfkSeconds or 0) > (StatsData.longestAfkSeconds or 0) then
					StatsData.longestAfkSeconds = remote.longestAfkSeconds
				end
			end
		end
	end)
	StatsData.execCount = (StatsData.execCount or 0) + 1
	StatsData.lastUsername = player.Name
end

local function statsSave()
	pcall(function()
		if writefile then
			writefile(STATS_FILE, HttpService:JSONEncode(StatsData))
		end
	end)
end

statsLoad()
statsSave()

-- track cash gains
task.spawn(function()
	while true do
		local ls = player:FindFirstChild("leaderstats")
		local cash = ls and (ls:FindFirstChild("Cash") or ls:FindFirstChild("Money") or ls:FindFirstChild("cash"))
		if cash and (cash:IsA("NumberValue") or cash:IsA("IntValue")) then
			if sessionMoneyBase == nil then
				sessionMoneyBase = cash.Value
			else
				local gained = cash.Value - sessionMoneyBase
				if gained > 0 then
					StatsData.totalMoneyGained = (StatsData.totalMoneyGained or 0) + gained
					sessionMoneyBase = cash.Value
					statsSave()
				elseif cash.Value < sessionMoneyBase then
					sessionMoneyBase = cash.Value
				end
			end
		end
		-- AFK longest
		if afkActive then
			if not afkSessionStart then afkSessionStart = os.clock() end
			currentAfkSeconds = os.clock() - afkSessionStart
			if currentAfkSeconds > (StatsData.longestAfkSeconds or 0) then
				StatsData.longestAfkSeconds = currentAfkSeconds
			end
		else
			if afkSessionStart then
				local dur = os.clock() - afkSessionStart
				if dur > (StatsData.longestAfkSeconds or 0) then
					StatsData.longestAfkSeconds = dur
					statsSave()
				end
				afkSessionStart = nil
			end
		end
		task.wait(1)
	end
end)


