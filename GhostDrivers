local function updateBtn(btn, textLabel, iconLabel, btnStroke, indicator, stateTag, active)
	btn:SetAttribute("Active", active)
	if active then
		stateTag.Text = "ON"
		stateTag.TextColor3 = Color3.fromRGB(0, 220, 255)
		textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
		if iconLabel then iconLabel.ImageColor3 = Color3.fromRGB(0, 220, 255) end
		TweenService:Create(btnStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(0, 220, 255)}):Play()
		TweenService:Create(indicator, TweenInfo.new(0.2), {BackgroundTransparency = 0}):Play()
	else
		stateTag.Text = "OFF"
		stateTag.TextColor3 = Color3.fromRGB(90, 90, 110)
		textLabel.TextColor3 = Color3.fromRGB(170, 170, 190)
		if iconLabel then iconLabel.ImageColor3 = Color3.fromRGB(130, 130, 150) end
		TweenService:Create(btnStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(40, 40, 55)}):Play()
		TweenService:Create(indicator, TweenInfo.new(0.2), {BackgroundTransparency = 1}):Play()
	end
end

