-- ==================== RACE FRAME DETECTION ====================
local raceFrameVisible = false
local raceInfoText = nil

local function checkRaceFrame()
	if not RACE_ENABLED then return end
	local raceMode = playerGui:FindFirstChild("RaceMode")
	if not raceMode then return end
	local mainFrame = raceMode:FindFirstChildOfClass("Frame")
	if not mainFrame then return end
	local left = mainFrame:FindFirstChild("Left")
	if left then
		if left.Visible and not raceFrameVisible then
			raceFrameVisible = true
			task.wait(6.5)
			if raceInfoText then
				raceInfoText.Text = "Avoid getting on leaderboard!"
				task.wait(6.5)
				raceInfoText.Text = "Avoid getting on leaderboard!"
			end
		elseif not left.Visible then
			raceFrameVisible = false
		end
	end
end

RunService.Heartbeat:Connect(function()
	checkRaceFrame()
end)

