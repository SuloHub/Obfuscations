-- Reliable clipboard helper (works in most executors; falls back gracefully)
local function copyToClipboard(text)
	text = tostring(text or "")
	-- Preferred: executor setclipboard
	if typeof(setclipboard) == "function" then
		local ok = pcall(setclipboard, text)
		if ok then return true end
	end
	-- Some environments expose Clipboard global
	if Clipboard and typeof(Clipboard.SetText) == "function" then
		local ok = pcall(function() Clipboard:SetText(text) end)
		if ok then return true end
	end
	-- Last resort: try any service that might exist
	local ok = pcall(function()
		local svc = game:GetService("ClipboardService")
		if svc and svc.SetText then svc:SetText(text) end
	end)
	if ok then return true end
	warn("[CCT] Clipboard not available in this environment. Text was: " .. text)
	return false
end

