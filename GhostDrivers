local function makeSlider(parent, labelText, y, min, max, default, callback)
	local container = Instance.new("Frame")
	container.Size = UDim2.new(1, -18, 0, 50)
	container.Position = UDim2.new(0, 9, 0, y)
	container.BackgroundTransparency = 1
	container.ZIndex = 23
	container.Parent = parent

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, -50, 0, 16)
	label.BackgroundTransparency = 1
	label.Text = labelText
	label.TextColor3 = Color3.fromRGB(160, 160, 180)
	label.TextSize = 11
	label.Font = Enum.Font.GothamBold
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.ZIndex = 24
	label.Parent = container

	local valueLabel = Instance.new("TextLabel")
	valueLabel.Size = UDim2.new(0, 42, 0, 16)
	valueLabel.Position = UDim2.new(1, -42, 0, 0)
	valueLabel.BackgroundTransparency = 1
	valueLabel.Text = tostring(default)
	valueLabel.TextColor3 = Color3.fromRGB(0, 220, 255)
	valueLabel.TextSize = 11
	valueLabel.Font = Enum.Font.Code
	valueLabel.TextXAlignment = Enum.TextXAlignment.Right
	valueLabel.ZIndex = 24
	valueLabel.Parent = container

	local barBG = Instance.new("Frame")
	barBG.Size = UDim2.new(1, 0, 0, 6)
	barBG.Position = UDim2.new(0, 0, 0, 28)
	barBG.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
	barBG.BorderSizePixel = 0
	barBG.ZIndex = 24
	barBG.Parent = container

	local barFill = Instance.new("Frame")
	barFill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
	barFill.BackgroundColor3 = Color3.fromRGB(0, 220, 255)
	barFill.BorderSizePixel = 0
	barFill.ZIndex = 25
	barFill.Parent = barBG

	local knob = Instance.new("Frame")
	knob.Size = UDim2.new(0, 12, 0, 12)
	knob.Position = UDim2.new((default - min) / (max - min), -6, 0.5, -6)
	knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	knob.BorderSizePixel = 0
	knob.ZIndex = 26
	knob.Parent = barBG

	local dragging = false
	local function update(val)
		val = math.clamp(val, min, max)
		local pct = (val - min) / (max - min)
		barFill.Size = UDim2.new(pct, 0, 1, 0)
		knob.Position = UDim2.new(pct, -6, 0.5, -6)
		valueLabel.Text = tostring(math.floor(val + 0.5))
		callback(val)
	end

	barBG.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
		end
	end)
	UIS.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	UIS.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local rel = (input.Position.X - barBG.AbsolutePosition.X) / barBG.AbsoluteSize.X
			update(min + rel * (max - min))
		end
	end)
end

